# La Lunatique — environment variables
# This file lists variable NAMES only. Never commit real secrets.

# --- Database (PostgreSQL — see prisma/schema.prisma) ---
# Dedicated app database, and a separate isolated database for the
# automated test suite (tests/ — never run against dev or prod data).
DATABASE_URL=postgresql://user:pass@host:5432/la_lunatique
TEST_DATABASE_URL=postgresql://user:pass@host:5432/la_lunatique_test

# --- Auth (better-auth — see lib/auth/auth.ts) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Stripe (not integrated yet — see lib/payments/provider.ts) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (not integrated yet — see lib/notifications/email.ts) ---
# Until a real provider is wired up, order-confirmation, verification,
# and password-reset emails only log their content/link to the server
# console in development, and throw if ever reached in production.
EMAIL_PROVIDER_API_KEY=

# --- Analytics (not integrated yet) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
