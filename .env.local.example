# La Lunatique — environment variables
# This file lists variable NAMES only. Never commit real secrets.

# --- Database (PostgreSQL — see prisma/schema.prisma) ---
# Dedicated app database, and a separate isolated database for the
# automated test suite (tests/ — never run against dev or prod data).
DATABASE_URL=postgresql://user:pass@host:5432/la_lunatique
TEST_DATABASE_URL=postgresql://user:pass@host:5432/la_lunatique_test

# --- Auth (better-auth — see lib/auth/auth.ts) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Stripe (TEST MODE keys only — see lib/payments/stripe.ts) ---
# Server-side secret key (sk_test_...) and webhook signing secret
# (whsec_..., from `stripe listen` locally or the Dashboard webhook
# endpoint in production) are never exposed to the browser. The
# publishable key (pk_test_...) is intentionally NEXT_PUBLIC_ — Stripe's
# own client-side SDK needs it, and it is not a secret.
# Live (sk_live_/pk_live_) keys must never be used until this project is
# explicitly authorised to go to real payments.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Reservation cleanup cron (see app/api/internal/release-expired-reservations) ---
# Bearer secret for a scheduler to call the expired-reservation sweep.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=

# --- Email (not integrated yet — see lib/notifications/email.ts) ---
# Until a real provider is wired up, order-confirmation, verification,
# and password-reset emails only log their content/link to the server
# console in development, and throw if ever reached in production.
EMAIL_PROVIDER_API_KEY=

# --- Analytics (not integrated yet) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Consultation booking (see app/(site)/consultation) ---
# The public embed URL for a Google Calendar "Appointment schedule"
# (Calendar → Create → Appointment schedule → Share → booking page
# link). No OAuth/API credentials needed — this is just an iframe URL.
NEXT_PUBLIC_BOOKING_URL=

# --- Google Search Console verification ---
# The <meta name="google-site-verification"> content value from
# Search Console → Settings → Ownership verification → HTML tag method,
# after you've added this domain as a property there.
GOOGLE_SITE_VERIFICATION=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
